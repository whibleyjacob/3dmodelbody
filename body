import React, { useState } from 'react';
import { Canvas } from '@react-three/fiber';
import { OrbitControls, PerspectiveCamera, RoundedBox } from '@react-three/drei';
import * as THREE from 'three';

// Materials
const blueMaterial = new THREE.MeshPhysicalMaterial({
    color: '#38bdf8',
    roughness: 0.3,
    metalness: 0.1,
    clearcoat: 0.3,
    clearcoatRoughness: 0.1
});

const highlightMaterial = new THREE.MeshPhysicalMaterial({
    color: '#ffffff',
    roughness: 0.2,
    metalness: 0.2,
    emissive: '#e0f2fe',
    emissiveIntensity: 0.3,
    clearcoat: 0.3
});

const hoverMaterial = new THREE.MeshPhysicalMaterial({
    color: '#7dd3fc',
    roughness: 0.3,
    metalness: 0.1,
    clearcoat: 0.2
});

// Shape
const latShape = new THREE.Shape();
const latH = 0.35;
const latWTop = 0.14;
const latWBot = 0.09;
latShape.moveTo(0, latH / 2);
latShape.lineTo(0, -latH / 2);
latShape.lineTo(-latWBot, -latH / 2);
latShape.lineTo(-latWTop, latH / 2);
latShape.closePath();

const latSettings = {
    steps: 1,
    depth: 0.02,
    bevelEnabled: true,
    bevelThickness: 0.02,
    bevelSize: 0.02,
    bevelSegments: 4
};

// Interactive wrapper
const InteractivePart = ({ name, isSelected, onClick, children, ...props }) => {
    const [hovered, setHovered] = useState(false);
    const material = isSelected ? highlightMaterial : (hovered ? hoverMaterial : blueMaterial);

    return (
        <group
            {...props}
            onClick={(e) => {
                e.stopPropagation();
                onClick(name);
            }}
            onPointerOver={(e) => {
                e.stopPropagation();
                setHovered(true);
                document.body.style.cursor = 'pointer';
            }}
            onPointerOut={(e) => {
                e.stopPropagation();
                setHovered(false);
                document.body.style.cursor = 'auto';
            }}
        >
            {React.Children.map(children, child =>
                React.isValidElement(child)
                    ? React.cloneElement(child, { material })
                    : child
            )}
        </group>
    );
};

// Helpers
const Capsule = ({ args, position = [0, 0, 0], rotation = [0, 0, 0], material }) => (
    <mesh position={position} rotation={rotation} material={material || blueMaterial}>
        <capsuleGeometry args={args} />
    </mesh>
);

const RoundedPart = ({ args, position = [0, 0, 0], radius = 0.02, smoothness = 4, rotation = [0, 0, 0], material }) => (
    <RoundedBox args={args} radius={radius} smoothness={smoothness} position={position} rotation={rotation} material={material || blueMaterial} />
);

// Body
const BodyParts = ({ selectedParts, onTogglePart }) => {
    const isSelected = (name) => selectedParts.includes(name);

    return (
        <group>
            <InteractivePart name="Head" isSelected={isSelected("Head")} onClick={onTogglePart}>
                <mesh position={[0, 1.7, 0]}>
                    <sphereGeometry args={[0.11, 32, 32]} />
                </mesh>
            </InteractivePart>

            <InteractivePart name="Chest" isSelected={isSelected("Chest")} onClick={onTogglePart}>
                <RoundedPart args={[0.32, 0.35, 0.08]} position={[0, 1.35, 0.04]} radius={0.06} />
            </InteractivePart>

            <InteractivePart name="Abdomen" isSelected={isSelected("Abdomen")} onClick={onTogglePart}>
                <RoundedPart args={[0.26, 0.3, 0.12]} position={[0, 1.1, 0.06]} radius={0.06} />
            </InteractivePart>

            <InteractivePart name="Right Upper Back" isSelected={isSelected("Right Upper Back")} onClick={onTogglePart}>
                <mesh position={[-0.005, 1.35, -0.03]}>
                    <extrudeGeometry args={[latShape, latSettings]} />
                </mesh>
            </InteractivePart>

            <InteractivePart name="Left Upper Back" isSelected={isSelected("Left Upper Back")} onClick={onTogglePart}>
                <mesh position={[0.005, 1.35, -0.03]} scale={[-1, 1, 1]}>
                    <extrudeGeometry args={[latShape, latSettings]} />
                </mesh>
            </InteractivePart>
        </group>
    );
};

// Main
export const BodyModel = ({ selectedBodyParts = [], onToggleBodyPart = () => {} }) => {
    return (
        <div className="w-full h-full flex items-center justify-center bg-transparent">
            <Canvas camera={{ position: [0, 1.3, 2.5], fov: 50 }}>
                <PerspectiveCamera makeDefault position={[0, 1.3, 2.5]} />

                <ambientLight intensity={0.8} />
                <spotLight position={[5, 10, 5]} angle={0.3} intensity={2} castShadow />
                <pointLight position={[-5, 5, -5]} intensity={1} />
                <hemisphereLight intensity={1.5} />

                <BodyParts
                    selectedParts={selectedBodyParts}
                    onTogglePart={onToggleBodyPart}
                />

                <OrbitControls
                    target={[0, 1.1, 0]}
                    enableZoom={false}
                    enablePan={false}
                />
            </Canvas>
        </div>
    );
};
